{
  "name": "mailo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.18"
  },
  "scripts": {
    "build": "turbo run build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration"
  },
  "devDependencies": {
    "oxfmt": "0.77.0",
    "turbo": "2.11.13"
  }
}
